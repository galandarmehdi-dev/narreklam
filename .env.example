# ─── Public (safe to expose in the browser) ─────────────────────────
# Supabase project URL and ANON (public) key — never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Where the site is served from.
#   GitHub Pages project site: /<repository-name>/   (e.g. /narreklam/)
#   Custom domain:             /
VITE_BASE_PATH=/

# Absolute public URL (no trailing slash). Used for canonical URLs, hreflang, sitemap, Open Graph.
VITE_SITE_URL=https://example.github.io/narreklam

# Show clearly-labelled DEMO portfolio projects when no real projects exist (never enable for launch).
VITE_SHOW_DEMO=false

# ─── Server-side only (Supabase Edge Function secrets — set with `supabase secrets set`) ───
# RESEND_API_KEY=re_xxx
# QUOTE_NOTIFY_EMAIL=info@your-domain.az
# QUOTE_FROM_EMAIL="NarReklam <noreply@your-domain.az>"
# ALLOWED_ORIGINS=https://example.github.io,http://localhost:5173
